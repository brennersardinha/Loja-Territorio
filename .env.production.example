# Copie para .env.production e preencha. Nunca versione o arquivo preenchido.

# Banco de dados
POSTGRES_DB=loja
POSTGRES_USER=loja
POSTGRES_PASSWORD=

# Segurança (gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=
# Faixa de IPs do proxy reverso/CDN na frente do nginx (ex.: 172.16.0.0/12 para a rede Docker)
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Endereço público da loja (sem barra no final)
STORE_PUBLIC_URL=https://www.minhaloja.com.br

# Pagamento e frete
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
MELHOR_ENVIO_TOKEN=
SHIPPING_ORIGIN_ZIP=

# E-mail transacional (recuperação de senha)
RESEND_API_KEY=
RESEND_FROM=

# Google Analytics 4 (opcional)
GA_MEASUREMENT_ID=

# Seed inicial (npm run seed)
STORE_NAME=Minha Loja
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
