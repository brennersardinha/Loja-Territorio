# Banco de dados (compatível com o docker-compose.yml da raiz)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=loja_dev
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10

# Servidor
PORT=4000
JWT_SECRET=troque-este-segredo-em-producao
CORS_ORIGIN=http://localhost:5173
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Endereço público da loja: links de e-mail, sitemap e robots.txt (obrigatório em produção)
STORE_PUBLIC_URL=http://localhost:5173

# Pagamento de teste: confirma qualquer pedido sem cobrança. Sempre desativado com NODE_ENV=production.
PAYMENT_SANDBOX_ENABLED=true

# Credenciais referenciadas pelas integrações; nunca são salvas no banco.
STRIPE_SECRET_KEY=
# Chave publica (pk_test_/pk_live_) usada pelo formulario de cartao na vitrine.
STRIPE_PUBLISHABLE_KEY=
MELHOR_ENVIO_TOKEN=
SHIPPING_ORIGIN_ZIP=01001000

# E-mail transacional (recuperação de senha)
RESEND_API_KEY=
RESEND_FROM=

# Webhooks de pedido (integração futura com o sistema de estoque)
WEBHOOK_POLL_MS=5000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=6

# Seed de dados básicos (npm run seed)
STORE_NAME=Minha Loja
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@minhaloja.com.br
SEED_ADMIN_PASSWORD=
SEED_DEMO=false
